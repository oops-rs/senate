    "secretary.elsewhere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The seat office::secretary has no session on this machine: it is someone else's, or it runs on another Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "office::secretary 这个席位在本机上没有会话：它属于别人，或在另一台 Mac 上运行。"
          }
        }
      }
    },
    "secretary.ended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your secretary's terminal ended (a restart, perhaps). Your next message brings it back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的秘书的终端已结束（也许是因为重启）。你的下一条消息会让它恢复。"
          }
        }
      }
    },
    "secretary.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As %@, in office; your first message starts it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 的身份，在 office；你的第一条消息会启动它"
          }
        }
      }
    },
    "secretary.not_recorded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your secretary isn't running yet. Tell it what you're working on and it starts: it opens a committee for each project, gives each chair a brief, and follows up through the chairs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的秘书还没有运行。告诉它你在做什么，它就会启动：为每个项目开一个委员会，给每位主席一份简报，并通过主席跟进。"
          }
        }
      }
    },
    "secretary.not_seated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your secretary started, but its session hasn't appeared here yet. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的秘书已启动，但它的会话还没有出现在这里。请稍后再试。"
          }
        }
      }
    },
