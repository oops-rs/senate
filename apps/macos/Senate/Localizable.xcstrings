    "about.credits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach your coding agents through Senate: what waits on you, approvals, and this machine's hosted sessions. A client of the senated daemon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Senate 联系你的编程代理：等待你的事项、审批，以及本机的托管会话。senated 守护进程的客户端。"
          }
        }
      }
    },
