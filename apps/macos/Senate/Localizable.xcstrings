    "approvals.terminals_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission prompts are answered here as you would in the terminal, and noted in the committee log. Any other choice is decided in the terminal itself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限提示可在此处回答，效果与在终端内相同，并记入委员会日志。其他选择只能在终端内决定。"
          }
        }
      }
    },
