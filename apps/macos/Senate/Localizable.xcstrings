    "past.forget_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes Senate's record of the session: it leaves History and search. The agent's own transcript stays where its runtime keeps it, and nothing in the committee's log is touched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除 Senate 对该会话的记录：它将从历史和搜索中消失。代理自己的对话记录仍留在其运行时存放的位置，委员会日志中的内容也不受影响。"
          }
        }
      }
    },
