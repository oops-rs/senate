    "scenes.about": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A scene shows this Senate's activity in its own way: a town, a map, a dashboard. It is a small web bundle someone else wrote, and it runs here in isolation: no network, only the files it came with, and only what Observe shares with it once you allow it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场景以自己的方式呈现这个 Senate 的动态：小镇、地图或仪表盘。它是别人编写的小型网页包，在这里隔离运行：不联网，只用自带的文件，你允许之后也只能看到 Observe 分享给它的内容。"
          }
        }
      }
    },
